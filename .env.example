# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/helpdesk?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# API
API_PORT=4000
API_URL="http://localhost:4000"

# File storage (local disk). Change this path per environment.
FILE_STORAGE_ROOT="C:/source-project/project-file/it-helpdesk-files"
# Path inside API container when running via Docker (bind-mounted from FILE_STORAGE_ROOT on host)
FILE_STORAGE_CONTAINER_PATH="/data/files"

# Web (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
PORT=3000
WEB_URL="http://localhost:3000"
