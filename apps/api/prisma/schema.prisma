generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  IT_STAFF
  SUPERVISOR
  GM
}

enum TicketCategory {
  HARDWARE
  NETWORK
  SOFTWARE_BUG
  FEATURE_REQUEST
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_APPROVAL
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketType {
  STANDARD
  QUICK_TICKET
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  nameTh       String?
  nameEn       String?
  role         UserRole  @default(USER)
  employeeId   String?   @unique
  jobTitle     String?
  extension    String?
  mobile       String?
  avatarUrl    String?
  department   String?
  isActive     Boolean   @default(true)
  lastSignInAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requestedTickets Ticket[]               @relation("TicketRequester")
  assignments      TicketAssignee[]
  worklogs         Worklog[]
  approvalsRequested QuickTicketApproval[] @relation("ApprovalRequester")
  approvalsDecided   QuickTicketApproval[] @relation("ApprovalDecider")
  auditLogs        AuditLog[]

  @@index([role, isActive])
  @@map("users")
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  category    TicketCategory
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  type        TicketType     @default(STANDARD)
  requesterId String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  requester User             @relation("TicketRequester", fields: [requesterId], references: [id])
  assignees TicketAssignee[]
  worklogs  Worklog[]
  approval  QuickTicketApproval?

  @@index([status])
  @@index([priority])
  @@index([requesterId])
  @@map("tickets")
}

model TicketAssignee {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String
  assignedAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@map("ticket_assignees")
}

model Worklog {
  id           String   @id @default(cuid())
  ticketId     String
  authorId     String
  note         String
  minutesSpent Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
  @@map("worklogs")
}

model QuickTicketApproval {
  id            String         @id @default(cuid())
  ticketId      String         @unique
  requestedById String
  approvedById  String?
  status        ApprovalStatus @default(PENDING)
  reason        String?
  decidedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ticket      Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedBy  User?  @relation("ApprovalDecider", fields: [approvedById], references: [id])

  @@map("quick_ticket_approvals")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model ReferenceCatalog {
  id        String   @id @default(cuid())
  code      String   @unique
  nameTh    String   @map("name_th")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items ReferenceItem[]

  @@map("reference_catalogs")
}

model ReferenceItem {
  id        String   @id @default(cuid())
  catalogId String   @map("catalog_id")
  code      String
  labelTh   String   @map("label_th")
  labelEn   String   @map("label_en")
  icon      String?
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  catalog ReferenceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, code])
  @@index([catalogId, isActive, sortOrder])
  @@map("reference_items")
}
